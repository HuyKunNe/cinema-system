root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,xml}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,jsonc,md}]
indent_style = space
indent_size = 2

[*.properties]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = 100

[*.{cmd,bat}]
end_of_line = crlf

[*.java]
indent_style = space
indent_size = 4
tab_width = 4

[mvnw]
end_of_line = lf
