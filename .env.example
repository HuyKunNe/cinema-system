          "USER_JWT_PUBLIC_KEY_LOCATION": "file:E:/java/cinema-system/.local/keys/user-service-public.pem",
          "CINEMA_LOCAL_BOOTSTRAP_ENABLED": "true",
          "CINEMA_LOCAL_BOOTSTRAP_INVENTORY_MOVIE_CLIENT_ENABLED": "true",
          "INVENTORY_MOVIE_CLIENT_ID": "inventory-movie-catalog",
          "INVENTORY_MOVIE_CLIENT_SECRET": "78f2282e1c1f9ca024444399e2e1687320df85f1afc54640aa23f6985dbe3992",
          "USER_GOOGLE_LOGIN_ENABLED": "true",
          "USER_GOOGLE_CLIENT_ID": "",
