          "USER_DB_USERNAME": "root",
          "USER_DB_PASSWORD": "huykun17",
          "USER_AUTHORIZATION_SERVER_ISSUER": "http://localhost:8082",
          "USER_JWT_AUDIENCES": "cinema-api",
