{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Config Service",
      "type": "process",
      "command": "${workspaceFolder}\\mvnw.cmd",
      "args": ["-pl", "infrastructure/config-service", "spring-boot:run"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Discovery Service",
      "type": "process",
      "command": "${workspaceFolder}\\mvnw.cmd",
      "args": ["-pl", "infrastructure/discovery-service", "spring-boot:run"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CONFIG_SERVER_URL": "http://localhost:8888"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Run User Service",
